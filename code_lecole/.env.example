# true while building: errors show their details. false when the site is live (people see errors/error.php only)
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database settings (matches docker-compose: MySQL on port 3308, root password "root")
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=l_ecole
DB_USER=root
DB_PASS=root

# Sending email (config/mail.php). Resend: sign up at resend.com with the test inbox, make an API key.
# Gmail instead: SMTP_HOST=smtp.gmail.com, SMTP_USER + MAIL_FROM = the account, SMTP_PASS = its app password.
# MAIL_DRIVER=log writes emails to storage/logs/mail.log instead of sending them.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
MAIL_FROM=onboarding@resend.dev
# Testing: every email goes to this one inbox. Leave it empty when the site is live (emails go to the real people).
MAIL_REDIRECT_TO=your-test-inbox@example.com
